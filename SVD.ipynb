    "import numpy as np\n",
    "\n",
    "# Define the matrix\n",
    "A = np.array([[1, 0, 1],\n",
    "              [-1, 1, 0]])\n",
    "\n",
    "# Compute the SVD of the matrix\n",
    "U, S, V = np.linalg.svd(A,full_matrices=True)\n"
